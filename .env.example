# Copiá este archivo a .env y ajustá lo que necesites

DATABASE_URL="postgresql://tombola:tombola@localhost:5432/tombola?schema=public"

# Secreto para firmar los JWT (organizadores/admin y tokens de reingreso de participantes)
JWT_SECRET="cambiame-por-un-secreto-largo-y-random"

# Puerto del servidor HTTP
PORT=4000

# Credenciales del admin que se crea automáticamente al correr el seed
ADMIN_EMAIL="admin@tu-dominio.com"
ADMIN_PASSWORD="usa-una-contrasena-larga-y-unica"

# URL base pública (para armar los links que se comparten). En local queda así.
PUBLIC_BASE_URL="http://localhost:4000"

# Entorno: en "development" los códigos de verificación y el link de reingreso
# se devuelven en la respuesta de la API y se imprimen por consola, para poder
# probar todo el flujo sin tener un proveedor de email/SMS conectado todavía.
NODE_ENV="development"
