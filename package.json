{
  "name": "tombola-backend",
  "version": "1.0.0",
  "description": "Backend real de sorteos, bingos y rifas — Express + PostgreSQL + Prisma",
  "main": "dist/src/index.js",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "seed:prod": "node dist/prisma/seed.js",
    "migrate": "prisma migrate dev",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "test:live": "node tests/live-sync.test.cjs",
    "test:live:server": "npm run build && node tests/live-server.test.cjs",
    "test:live:browser": "node tests/live-browser.cjs",
    "test:bingo": "npm run build && node tests/ganadores-bingo.test.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0",
    "prisma": "^5.19.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/pdfkit": "^0.13.4",
    "@types/ws": "^8.5.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
